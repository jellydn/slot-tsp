+bool Vm::deserializeLuaState(const char* src, size_t len) {
+    // Build and validate independently; a Lua error must not destroy the running cart.
+    if (!src || !len || len > 1024 * 1024) return false;
+    auto allocated = new size_t(0);
+    lua_State* staged = lua_newstate(snapshotAlloc, allocated);
+    if (!staged) { delete allocated; return false; }
+    // Eris builds prototype links without GC write barriers. Do not collect
+    // its incomplete graph; the staged allocator still bounds peak memory.
+    lua_gc(staged, LUA_GCSTOP, 0);
+    lua_setpico8memory(staged, _memory->data);
+    if (!_initializeLuaState(staged)) {
+        closeSnapshotLua(staged);
+        return false;
+    }
+    lua_getglobal(staged, "eris");
+    lua_getfield(staged, -1, "restore_all");
+    lua_pushlstring(staged, src, len);
+    if (lua_pcall(staged, 1, 0, 0) != LUA_OK) {
+        closeSnapshotLua(staged);
+        return false;
+    }
+    lua_settop(staged, 0);
+    lua_gc(staged, LUA_GCRESTART, 0);
+    closeSnapshotLua(_luaState);
+    _luaState = staged;
+    return true;
+}
 
