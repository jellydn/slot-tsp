--- a/platform/libretro/slotstate.h
+++ b/platform/libretro/slotstate.h
@@ -0,0 +1,106 @@
+// Slot's pinned, build-specific state format. No legacy-state fallback.
+#include <stddef.h>
+#include <stdint.h>
+#include <type_traits>
+#include <cmath>
+
+#ifndef SLOT_STATE_ABI
+#define SLOT_STATE_ABI "scratch-not-for-distribution"
+#endif
+
+namespace {
+constexpr size_t luaCapacity = 1024 * 1024;
+struct StateHeader {
+    char magic[8];
+    char abi[65];
+    uint32_t version, endian, runtimeSize, luaSize;
+    uint64_t cart, frame;
+    double frameTime, previousTime;
+    int16_t mouseX, mouseY;
+    uint8_t held, down, mouseButtons;
+    uint32_t checksum;
+};
+constexpr char stateMagic[8] = {'S','L','O','T','F','0','8',0};
+constexpr char stateAbi[65] = SLOT_STATE_ABI;
+constexpr size_t stateSize = sizeof(StateHeader) + sizeof(Vm::Snapshot) + luaCapacity;
+static_assert(std::is_trivially_copyable<Vm::Snapshot>::value, "runtime image must be copyable");
+static_assert(sizeof(StateHeader) == 144 && offsetof(StateHeader, checksum) == 136,
+    "state header ABI changed: bump format version and update probes");
+
+uint32_t stateChecksum(const void* data) {
+    const auto bytes = static_cast<const uint8_t*>(data);
+    uint32_t hash = 2166136261U;
+    for (size_t i = 0; i < stateSize; ++i) {
+        if (i >= offsetof(StateHeader, checksum) && i < offsetof(StateHeader, checksum) + 4) continue;
+        hash = (hash ^ bytes[i]) * 16777619U;
+    }
+    return hash;
+}
+}
+
+EXPORT size_t retro_serialize_size() { return stateSize; }
+
+EXPORT bool retro_serialize(void* data, size_t size) {
+    if (!data || size != stateSize) return false;
+    Vm::Snapshot runtime{};
+    if (!_vm->captureSnapshot(runtime)) return false;
+    // The Lua writer copies only after checking its destination bound.
+    static char lua[luaCapacity];
+    const size_t length = _vm->serializeLuaState(lua, luaCapacity);
+    if (!length) return false;
+    StateHeader header{};
+    memcpy(header.magic, stateMagic, sizeof(stateMagic));
+    memcpy(header.abi, stateAbi, sizeof(stateAbi));
+    header.version = 1;
+    header.endian = 0x12345678;
+    header.runtimeSize = sizeof(runtime);
+    header.luaSize = length;
+    header.cart = _vm->snapshotCartIdentity();
+    header.frame = frame;
+    header.frameTime = frame_time;
+    header.previousTime = prev_frame_time;
+    header.mouseX = picoMouseX;
+    header.mouseY = picoMouseY;
+    header.held = kHeld;
+    header.down = kDown;
+    header.mouseButtons = mouseBtnState;
+    auto bytes = static_cast<char*>(data);
+    memset(bytes, 0, size);
+    memcpy(bytes, &header, sizeof(header));
+    memcpy(bytes + sizeof(header), &runtime, sizeof(runtime));
+    memcpy(bytes + sizeof(header) + sizeof(runtime), lua, length);
+    header.checksum = stateChecksum(data);
+    memcpy(bytes, &header, sizeof(header));
+    return true;
+}
+
+EXPORT bool retro_unserialize(const void* data, size_t size) {
+    if (!data || size != stateSize) return false;
+    StateHeader header;
+    memcpy(&header, data, sizeof(header));
+    if (memcmp(header.magic, stateMagic, sizeof(stateMagic))
+        || memcmp(header.abi, stateAbi, sizeof(stateAbi)) || header.version != 1
+        || header.endian != 0x12345678 || header.runtimeSize != sizeof(Vm::Snapshot)
+        || !header.luaSize || header.luaSize > luaCapacity
+        || header.cart != _vm->snapshotCartIdentity()
+        || !std::isfinite(header.frameTime) || !std::isfinite(header.previousTime)
+        || header.frame > SIZE_MAX || header.checksum != stateChecksum(data)) {
+        return false;
+    }
+    const auto bytes = static_cast<const char*>(data);
+    Vm::Snapshot runtime;
+    memcpy(&runtime, bytes + sizeof(header), sizeof(runtime));
+    if (!_vm->validSnapshot(runtime)) return false;
+    if (!_vm->deserializeLuaState(bytes + sizeof(header) + sizeof(runtime), header.luaSize)) return false;
+    // No fallible parse remains after the independent Lua state was accepted.
+    _vm->applySnapshot(runtime);
+    frame = header.frame;
+    frame_time = header.frameTime;
+    prev_frame_time = header.previousTime;
+    picoMouseX = header.mouseX;
+    picoMouseY = header.mouseY;
+    kHeld = header.held;
+    kDown = header.down;
+    mouseBtnState = header.mouseButtons;
+    return true;
+}
