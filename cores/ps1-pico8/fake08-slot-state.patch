+uint64_t Vm::snapshotCartIdentity() const {
+    if (!_loadedCart) return 0;
+    uint64_t hash = 14695981039346656037ULL;
+    for (unsigned char c : _loadedCart->LuaString) hash = (hash ^ c) * 1099511628211ULL;
+    for (unsigned char c : _loadedCart->CartRom.data) hash = (hash ^ c) * 1099511628211ULL;
+    return hash;
+}
+
+bool Vm::captureSnapshot(Snapshot& out) {
+    if (!_loadedCart || _cartChangeQueued || !_cartLoadError.empty()) return false;
+    out = {};
+    out.ram = *_memory;
+    out.audio = _audio->_audioState;
+    out.fps = _targetFps;
+    out.frames = _picoFrameCount;
+    out.cartdataCount = _cartdataKeyCount;
+    out.noise = z8::synth::noiseState;
+    out.paused = _pauseMenu;
+    out.clearInput = _clearInputOnResume;
+    out.audioPaused = _audio->_paused;
+    memcpy(out.draw, _drawStateCopy, sizeof(out.draw));
+    out.down = _input->_currentKDown;
+    out.held = _input->_currentKHeld;
+    memcpy(out.repeats, _input->_framesHeld, sizeof(out.repeats));
+    out.mouseX = _input->_mouseX;
+    out.mouseY = _input->_mouseY;
+    out.mouseButtons = _input->_mouseBtnState;
+    out.kbDown = _input->_kbDown;
+    for (int i = 0; i < 4; ++i) if (!snapshotString(out.keys[i], _cartdataKeys[i])) return false;
+    return snapshotString(out.currentKey, _currentCartdataKey)
+        && snapshotString(out.previous, _prevCartKey)
+        && snapshotString(out.breadcrumb, _cartBreadcrumb)
+        && snapshotString(out.param, _cartParam)
+        && snapshotString(out.keyboard, _input->_kbKey)
+        && validSnapshot(out);
+}
+
+bool Vm::validSnapshot(const Snapshot& in) const {
+    if ((in.fps != 30 && in.fps != 60) || in.frames < 0 || in.cartdataCount < 0
+        || in.cartdataCount > 4 || in.paused > 1 || in.clearInput > 1
+        || in.audioPaused > 1 || in.kbDown > 1 || !in.noise) return false;
+    for (const auto& key : in.keys) if (!memchr(key, 0, sizeof(key))) return false;
+    if (!memchr(in.currentKey, 0, sizeof(in.currentKey))
+        || !memchr(in.previous, 0, sizeof(in.previous))
+        || !memchr(in.breadcrumb, 0, sizeof(in.breadcrumb))
+        || !memchr(in.param, 0, sizeof(in.param))
+        || !memchr(in.keyboard, 0, sizeof(in.keyboard))) return false;
+    return true;
+}
+
+void Vm::applySnapshot(const Snapshot& in) {
+    *_memory = in.ram;
