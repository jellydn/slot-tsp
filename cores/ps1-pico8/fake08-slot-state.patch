+    memcpy(_input->_framesHeld, in.repeats, sizeof(in.repeats));
+    _input->_mouseX = in.mouseX;
+    _input->_mouseY = in.mouseY;
+    _input->_mouseBtnState = in.mouseButtons;
+    _input->_kbDown = in.kbDown;
+    _input->_kbKey = in.keyboard;
+    _cartChangeQueued = false;
