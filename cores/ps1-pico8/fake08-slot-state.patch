+static void* snapshotAlloc(void* context, void* ptr, size_t oldSize, size_t size) {
+    auto& used = *static_cast<size_t*>(context);
+    if (!ptr) oldSize = 0;
+    const size_t limit = 32 * 1024 * 1024;
+    if (size > limit || used - oldSize > limit - size) return nullptr;
+    if (!size) {
+        free(ptr);
+        used -= oldSize;
+        return nullptr;
+    }
+    void* next = realloc(ptr, size);
+    if (next) used = used - oldSize + size;
+    return next;
+}
+
+static void closeSnapshotLua(lua_State* state) {
+    void* context;
+    bool bounded = lua_getallocf(state, &context) == snapshotAlloc;
+    lua_close(state);
+    if (bounded) delete static_cast<size_t*>(context);
+}
